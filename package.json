{
  "name": "mora-shawiri-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine officiel de MORA Shawiri — agence digitale à Moroni, Union des Comores.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:provision": "node scripts/provision-admins.mjs",
    "db:configure": "node scripts/configure-auth.mjs",
    "auth:emails": "node --import tsx scripts/configure-auth-emails.mjs",
    "db:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-security.mjs",
    "auth:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-auth.mjs",
    "perms:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-permissions.mjs",
    "docs:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-documents.mjs",
    "relation:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-relation.mjs",
    "routes:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-routes.mjs",
    "commerce:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-commerce.mjs",
    "facturation:verify": "node scripts/run-with-client-sequence.mjs --tsx scripts/verify-facturation.mjs",
    "affiliation:verify": "node scripts/run-with-client-sequence.mjs --tsx scripts/verify-affiliation.mjs",
    "catalogue:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-catalogue.mjs",
    "contenus:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-contenus.mjs",
    "client:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-client.mjs",
    "notifications:verify": "node scripts/run-with-client-sequence.mjs scripts/verify-notifications.mjs",
    "client:sequence:restaurer": "node scripts/run-with-client-sequence.mjs --restaurer",
    "pdf:samples": "tsx scripts/render-invoice-samples.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "nodemailer": "^7.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
