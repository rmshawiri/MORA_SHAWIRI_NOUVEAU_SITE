# ============================================================
#  MORA Shawiri — Exemple de variables d'environnement
#  Ce fichier documente les variables NÉCESSAIRES (noms uniquement).
#  IL NE CONTIENT AUCUNE VALEUR SECRÈTE RÉELLE.
#
#  Copier vers `.env.local` et renseigner les vraies valeurs (jamais commité).
# ============================================================

# ---------- PUBLIC (exposé au navigateur) ----------
# Domaine public officiel du site (ex: https://shawiri.com). JAMAIS codé en dur dans le code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- SUPABASE (base, auth, storage) ----------
# URL du projet Supabase (public).
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique anon (frontend, non secrète par nature mais à surveiller).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé SERVICE ROLE — SECRÈTE, exclusivement côté serveur. JAMAIS exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- EMAIL (transactionnel) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=contact@morashawiri.com
MAIL_REPLY_TO=contact@morashawiri.com

# ---------- SESSION / AUTH ----------
# Secret de session — SECRÈT (ne jamais mettre de valeur "secret" en production).
SESSION_SECRET=

# ---------- ANALYTICS (public) ----------
NEXT_PUBLIC_ANALYTICS_ID=

# ---------- PAIEMENT (V1) ----------
# Clés privées de paiement — SECRÈTES, côté serveur uniquement.
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
