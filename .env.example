# =========================================================
# MORA SHAWIRI — VARIABLES D'ENVIRONNEMENT
#
# Modèle destiné au dépôt Git : il documente les variables
# attendues et ne doit contenir AUCUNE valeur secrète réelle.
#
# Les valeurs réelles vivent dans `.env.local` (jamais versionné)
# et, pour les déploiements, dans les variables d'environnement Vercel.
# =========================================================


# =========================================================
# SITE — configuration publique
# =========================================================

# URL publique de production, sans slash final.
# Permet de changer de domaine sans modifier le code.
NEXT_PUBLIC_SITE_URL=https://mora-shawiri-nouveau-site.vercel.app


# =========================================================
# SMTP — envoi du formulaire de devis (serveur uniquement)
#
# Utilisé par la route `src/app/api/contact/route.ts`.
# Si ces variables sont absentes, le site reste pleinement
# fonctionnel : seule la notification e-mail est désactivée,
# le parcours WhatsApp du formulaire continue de fonctionner.
# =========================================================

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# Adresse qui reçoit les demandes de devis.
CONTACT_EMAIL=


# =========================================================
# SUPABASE — configuration de l'APPLICATION
#
# Ces variables décrivent le projet Supabase que l'application
# utilise DANS L'ENVIRONNEMENT OÙ ELLE TOURNE.
#
# `NEXT_PUBLIC_SUPABASE_ENV` déclare explicitement ce que les
# clés désignent :
#
#   shared  un projet Supabase unique sert tous les contextes.
#           C'est la situation actuelle : le plan Supabase retenu
#           n'autorise qu'un projet. La séparation est différée,
#           pas abandonnée, et le code le dit.
#
#   dev     deux projets distincts. Dès qu'un second projet
#   prod    existe, il suffit de renseigner ces valeurs : aucune
#           ligne de code ne change, et les contrôles de
#           cohérence deviennent actifs — une prévisualisation ne
#           peut plus atteindre la base de production, et la
#           production ne peut plus tourner sur celle de
#           développement.
#
# Répartition Vercel aujourd'hui :
#   Production / Preview / Development → shared
#
# Répartition Vercel le jour de la séparation :
#   Production → prod ; Preview et Development → dev
# =========================================================

# « shared », « dev » ou « prod ».
NEXT_PUBLIC_SUPABASE_ENV=shared

# Clés `NEXT_PUBLIC_*` : publiques par construction. Leur présence
# côté navigateur ne constitue jamais une autorisation — tout est
# encadré par les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé à privilèges : contourne RLS. Exclusivement serveur, jamais
# préfixée `NEXT_PUBLIC_`, jamais journalisée. Réservée au
# provisionnement et aux tâches serveur sans utilisateur.
SUPABASE_SECRET_KEY=


# =========================================================
# SUPABASE — OUTILLAGE (poste de travail uniquement)
#
# Jamais lu par l'application déployée. Ces variables servent aux
# scripts `scripts/*.mjs`, qui exigent un `--env` explicite afin
# qu'aucune commande n'atteigne les données réelles par mégarde.
#
# Le jeton d'accès ouvre l'API de gestion Supabase, seul canal
# capable d'exécuter du SQL. La clé secrète, elle, ne lit et
# n'écrit que des lignes : elle ne peut pas créer de table.
# Jeton personnel : https://supabase.com/dashboard/account/tokens
# Il se révoque depuis la même page une fois la phase terminée.
# =========================================================

SUPABASE_ACCESS_TOKEN=

# --env shared : les scripts réutilisent les variables de
# l'application ci-dessus. La référence du projet est déduite de
# NEXT_PUBLIC_SUPABASE_URL ; renseignez SUPABASE_PROJECT_REF
# uniquement si votre URL n'est pas au format <ref>.supabase.co.
SUPABASE_PROJECT_REF=

# --env dev / --env prod : à renseigner le jour de la séparation.
SUPABASE_DEV_PROJECT_REF=
SUPABASE_DEV_URL=
SUPABASE_DEV_PUBLISHABLE_KEY=
SUPABASE_DEV_SECRET_KEY=

SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROD_URL=
SUPABASE_PROD_PUBLISHABLE_KEY=
SUPABASE_PROD_SECRET_KEY=


# =========================================================
# PROVISIONNEMENT DES ADMINISTRATEURS (poste de travail uniquement)
#
# Lu par `scripts/provision-admins.mjs`. Aucun compte n'est codé
# en dur dans l'application : la liste vit ici, et le nombre
# d'administrateurs n'est pas limité.
#
# Un identifiant listé sans mot de passe est simplement ignoré.
# Les mots de passe ne sont jamais affichés, jamais journalisés,
# et jamais stockés ailleurs que dans Supabase Auth, sous forme
# de hash. Ils ne doivent JAMAIS être renseignés dans ce fichier :
# uniquement dans `.env.local`.
#
#   ADMIN_SEED_USERNAMES=rachade,amina,nizaati
#   ADMIN_SEED_<IDENTIFIANT>_PASSWORD=…
#   ADMIN_SEED_<IDENTIFIANT>_ROLE=SUPER_ADMIN | ADMIN
#   ADMIN_SEED_<IDENTIFIANT>_FULL_NAME=…        (facultatif)
#   ADMIN_SEED_<IDENTIFIANT>_EMAIL=…            (facultatif)
# =========================================================

ADMIN_SEED_USERNAMES=

# Domaine utilisé pour composer l'adresse interne d'un compte
# lorsqu'aucune adresse explicite n'est fournie.
ADMIN_SEED_EMAIL_DOMAIN=


# =========================================================
# OUTILLAGE DE DÉPLOIEMENT — jamais lu par l'application
#
# Ces jetons servent uniquement aux opérations d'administration
# (dépôt Git, projet Vercel) depuis un poste de travail.
# Ils ne doivent jamais être exposés au navigateur.
# =========================================================

GITHUB_TOKEN=
GITHUB_REPOSITORY=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
